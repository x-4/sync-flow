# ============================================================================
# 库存同步系统 —— 环境变量清单（1 个必填 + 12 个可选）
#
# 本服务**不读取 .env 文件**，也没有任何 dotenv 类依赖：配置全部来自进程
# 环境变量，lib/config.js 在模块加载时一次性固化。它是**变量字典**——按需
# 把条目粘到实际注入处：容器的 -e 参数、compose 的 environment 段、
# systemd 的 Environment= 指令、或平台控制台的环境变量面板。
#
# 【必填只有 UUID】其余 12 项全都有默认值，一个不设也能正常启动；下面列出
# 的值就是默认值，可直接省略。启动日志会打一行"生效配置"，把这 13 项的
# 实际取值全部列出（令牌只报是否已设置），排障时先看那一行。
#
# 【其余参数已固化为代码常量】lib/defaults.js 固化了 58 个参数，**不接受
# 环境变量覆盖**：它们要么只有一个合理取值，要么改了只会更糟，要么属于
# 内部实现细节。要改就改 defaults.js 再重新部署。清单见文末。
# ============================================================================

# ---- 必填（1）--------------------------------------------------------------
# 租户令牌。缺失或格式非法（非 8-4-4-4-12）时服务拒绝启动。它不能内置
# 默认值——令牌写进代码就会随仓库扩散，等于公开节点凭证。
# 生成：node -e "console.log(require('crypto').randomUUID())"
UUID=

# ---- 可选（12）-------------------------------------------------------------

# 同步端点池：逗号分隔的**绝对路径**，任一路径均可建立通道；索引 0 是主
# 路径（已下发客户端在用），其余供主通道被封锁时轮换。安全上建议改成非
# 默认值。三种坏形态（空 / 非绝对 / 重复）会让服务拒绝启动：它们的失败
# 方式是"健康检查 200 但客户端连不上"，宁可起不来也要在部署时暴露。
# SYNC_PATHS=/api/v2/inventory/live-stream,/api/v2/inventory/delta-feed,/api/v2/inventory/realtime-sync

# 诊断端点（GET /_diag/channel）的令牌，留空 = 仅回环来源可访问。
# 何时改：**凡是有反代/托管层在前面的部署都必须设置**——反代用回环地址
# 转发时"仅本机"判据当场失效，端点等于对全网开放。
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# DIAG_TOKEN=

# 设备配置端点（GET /api/v1/auth/device）的令牌，语义同上，留空 = 仅回环。
# 何时改：该端点返回一条含令牌与路径的完整节点链接，云端部署必须设置。
# DEVICE_TOKEN=

# 结构化日志级别：debug | info | warn | error。排查时临时调到 debug，
# 生产保持 warn（容器 stdout 有采集成本）。
LOG_LEVEL=warn

# 数据报通道的解析后端，逗号分隔，需为 http(s):// 形式。通常**不用管**：
# 留空 / 填错都会自动回落到内置 3 个后端（1.1.1.1 优先，9.9.9.9 与
# dns.google 备份），通道保持可用。要关闭通道请用下面的 SYNC_UDP_DISABLE=1
# ——"给本项填空值"不再有关闭效果（它与"没配"在面板上无法区分）。
# TELEMETRY_ENDPOINTS=

# 置 1 强制关闭数据报通道（**唯一的关闭方式**，语义明确、一眼可辨）。
SYNC_UDP_DISABLE=0

# 出站目标准入：拒绝回环 / 链路本地（含云元数据 169.254.169.254）/ 私有
# 段 / 保留段。目标由客户端首包指定（协议语义，无法取消），但"允许用通道"
# 不等于"允许访问服务端所在网络的任意地址"。当内网关用才置 0。
SYNC_TARGET_GUARD=1

# 业务页面与接口是否要求登录，置 0 = 打开首页即见全部库存（仅调试门面）。
# 刻意**不影响**同步端点池：那些路径没注册进路由表，404 先于会话检查。
LOGIN_REQUIRED=1

# 全局并发通道上限。并发明显高于默认、或 fd 上限吃紧时才动（每条通道额外
# 占一个出站 socket）。单 IP 上限自动取它的一半。
MAX_TOTAL_CONNECTIONS=200

# "已握手但首包未到"的单 IP 上限。几乎不需要改：它按"浏览器首屏在一个
# RTT 内开出的隧道数"标定（默认 64），调小会直接表现为"浏览器找不到
# DNS 地址"，已真实发生过。
MAX_PENDING_PER_IP=64

# 同时运行的实例数。并发计数是进程内的，跑 N 个实例时有效上限会变成 N
# 倍；填了本项，配置层按实例数折算上限，使**总量**仍有上界。多副本 /
# serverless 自动扩容时**务必**按最大实例数填写。
DEPLOY_INSTANCES=1

# 【排查专用】置 1 时数据面逐项等价于参考实现，HTTP 面一个字节不动。
# 排查"能连上、能发消息，但浏览器打不开网页"时临时打开，定位后立刻置回
# 0——它会停用 10 项防护（含目标准入）。
SYNC_COMPAT_MODE=0

# ---- 平台注入（不需要设置，列出仅为排查时认得出来源）----------------------
# 监听端口，按此优先级回退：PORT > SERVER_PORT > APP_PORT > 默认 3000。
# 认别名是因为各平台用的名字不同；只认 PORT 会让迁移静默回落 3000，
# 表现为"部署成功却访问不了"。
PORT=3000
# SERVER_PORT=
# APP_PORT=

# ============================================================================
# 已固化为常量的参数（58 项，不接受环境变量覆盖）
#
# 这些参数仍然挂在 CONFIG 上（下游照旧读 CONFIG.XXX），只是取值来源从
# 环境变量变成了 lib/defaults.js 的常量，且取值与固化前的默认值**逐字
# 相等**。要改其中任何一项：改 lib/defaults.js，重新部署。
# 每项"为什么取这个值"以及"为什么不再支持环境变量覆盖"，都写在
# defaults.js 的对应注释里；此处只列名字与取值，格式 `参数名: 取值`。
# ============================================================================

# —— 进程编排与存储（由运行形态推导，不由人配）——
# STORAGE_DRIVER: fs（Serverless 形态自动切 memory）
# SINGLE_PROCESS: false（Serverless 形态自动切 true）
# DATA_DIR: <项目根>/data（Serverless 形态改到 $TMPDIR/aether-data）
# LISTEN_HOST: ''（留空 = 双栈，IPv4/IPv6 都能进）
# SERVERLESS_DATA_DIR_NAME: aether-data
# —— 进程间事件总线 ——
# EVENT_BUS_PORT: 3001 | EVENT_BUS_ENDPOINT: /internal/cache-feed
# EVENT_BUS_RECONNECT_MS: 2000
# —— 并发规模 ——
# MAX_CONNECTIONS_PER_IP_DIVISOR: 2（per-IP 上限 = 全局上限 / 2）
# MAX_PENDING_TOTAL: 128 | SYNC_TRUST_PROXY: false
# —— 非法批次退避 ——
# INVALID_BATCH_THRESHOLD: 20 | INVALID_BATCH_WINDOW: 60000
# INVALID_COOLDOWN: 300000 | INVALID_BATCH_PER_IP: true（按来源 IP 连坐）
# —— 传输层保活 ——
# TCP_KEEPALIVE_ENABLED: true（不再提供关闭方式）| TCP_KEEPALIVE_DELAY: 60000
# —— 业务门面 ——
# SESSION_TTL_SEC: 28800 | RESPONSE_DELAY_MS: 45 | THROTTLE_JITTER: false
# —— HTTP 响应层 ——
# SERVER_HEADER: nginx/1.24.0 | ENABLE_COMPRESSION: true
# COMPRESSION_MIN_SIZE: 512 | ENABLE_ETAG: true | MAX_BODY_BYTES: 65536
# —— HTTP 访问频次调控（令牌桶）——
# HTTP_PACE_ENABLED: true（不再提供整体关闭）| HTTP_PACE_LIMIT: 300
# HTTP_PACE_BURST: 150 | HTTP_PACE_TRUST_PROXY: false
# —— 出站流与解析 ——
# SYNC_STREAM_HWM: 262144 | SYNC_DNS_CACHE_TTL: 30000
# SYNC_DNS_CACHE_MAX: 1024 | SYNC_CARES_TIMEOUT_MS: 0（沿用 Node 默认）
# SYNC_RESOLVE_DOH_FALLBACK: true | SYNC_FIRST_BATCH_TIMEOUT: 30000
# SYNC_CLOSE_DELAY_BASE_MS: 100 | SYNC_CLOSE_DELAY_JITTER_MS: 200
# SYNC_OUTBOUND_IDLE_TIMEOUT: 120000 | SYNC_PENDING_FRAME_LIMIT: 64
# SYNC_MAX_PAYLOAD: 1048576
# —— 数据报通道 ——
# SYNC_UDP_PORT: 53 | UDP_MAX_QUERY_SIZE: 4096
# UDP_QUERY_LIMIT: 100 | UDP_QUERY_BURST: 512
# SYNC_DOH_MAX_INFLIGHT: 256 | SYNC_DOH_TIMEOUT_MS: 3000
# SYNC_DATAGRAM_BUFFER_MAX: 65536 | SYNC_DATAGRAM_COMPACT_MIN: 4096
# —— 帧层流量形状 ——
# WS_MASK_CSPRNG: true | WS_FORCE_SERVER_MASK: false
# WS_TLS_FINGERPRINT: chrome | WS_TLS_ALPN: h2,http/1.1
# —— 本机加速件 ——
# REQUIRE_NATIVE_ACCEL: false
# —— 业务节奏 ——
# SNAPSHOT_TTL: 15000 | CACHE_INTERVAL: 30000 | REPORT_INTERVAL: 60000
# GC_INTERVAL: 300000 | REPORT_RETENTION_DAYS: 7 | LOW_STOCK_THRESHOLD: 80
